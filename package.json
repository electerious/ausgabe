{
  "name": "ausgabe",
  "version": "2.1.3",
  "description": "Tiny logger with zero defaults",
  "keywords": [
    "log",
    "logger",
    "logging",
    "debug",
    "debugging",
    "console"
  ],
  "homepage": "https://github.com/electerious/ausgabe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electerious/ausgabe.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,md,yml}\"",
    "test": "npm run lint && node --test",
    "test:dev": "npm run lint && NODE_ENV=development node --test"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^6.0.0-rc.4",
    "@electerious/prettier-config": "^5.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
